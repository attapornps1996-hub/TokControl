# --- Auth / Security (ตั้งบน Cloud Run ด้วย — อย่า commit ค่าจริง) ---
# สุ่มสตริงยาว ๆ สำหรับ JWT (บังคับบน production)
# แนะนำให้ local .env ใช้ค่าเดียวกับ Cloud — TokDonate จะ bridge ผ่าน /api/profile ได้อยู่แล้วถ้าคนละค่า
JWT_SECRET=
# PIN ปลดล็อกแอดมินในแอป (ถ้าไม่ใส่ local จะสุ่มเก็บใน data/local-admin-pin.txt)
# production ห้ามใช้ change_me_admin_pin / 1234 — ตั้งค่าจริงบน Cloud Run
ADMIN_PIN=
# รหัสผ่าน seed บัญชี Pandy_Puncheroo ครั้งแรกเท่านั้น (ไม่ใส่ = ไม่ seed)
ADMIN_SEED_PASSWORD=
# CORS allowlist (คั่นด้วย comma) — ว่าง = ใช้ default tokcontrol + localhost
# CORS_ORIGINS=https://tokcontrol.com,https://www.tokcontrol.com
# จำกัดขนาด JSON body (Cloud ค่าเริ่มต้น 1mb, เดสก์ท็อป 10mb)
# JSON_BODY_LIMIT=1mb
# Google Chrome Speech API สำหรับเสียงสิริไทย (speech-api/v2/synthesize)
# ไม่ใช่คีย์เดียวกับ YOUTUBE_API_KEY
GOOGLE_TTS_API_KEY=

# Shared token Paper plugin HTTP bridge :8081 (ถ้าไม่ใส่ จะสร้างใน data/mc-bridge-token.txt)
# TOKCONTROL_BRIDGE_TOKEN=
# รหัส RCON ของเซิร์ฟ Minecraft ที่แอปติดตั้ง (ค่าเริ่มต้น tokcontrol — ต้องเปลี่ยนก่อนเปิดเซิร์ฟสาธารณะ)
# MC_RCON_PASSWORD=
# คีย์ sync คลังของขวัญระหว่างเครื่อง/cloud — ว่าง = ปิด sync
# GIFTS_SYNC_KEY=change_me_long_random_sync_key

# GitHub Release upload (npm run build → node scratch/upload_release.js)
GH_TOKEN=your_github_personal_access_token

# Gemini AI Chatbot — สร้าง API Key ที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Redirect URI: http://127.0.0.1:3000/api/spotify/callback
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# YouTube Data API v3 — ไม่บังคับสำหรับ Live Chat (มีโหมดสำรองอ่านแชทจากหน้าไลฟ์)
# ถ้าใส่คีย์ จะใช้ Data API ก่อน แล้วค่อย fallback
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# หลังล็อกอิน OAuth สำเร็จ — Electron เปิดหน้านี้เพื่อรับ token
OAUTH_SUCCESS_URL=http://127.0.0.1:3000/auth-success.html
APP_PUBLIC_URL=https://pandy-backend-302414976454.asia-southeast1.run.app

# SMTP สำหรับยืนยันอีเมล / ลืมรหัสผ่าน (Gmail App Password หรือ SMTP อื่น)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=TokControl <your_email@gmail.com>

# Google Login — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://127.0.0.1:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback

# Discord Login — https://discord.com/developers/applications
# Redirect: http://127.0.0.1:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://127.0.0.1:3000/api/auth/discord/callback

# --- In-app PRO payments (PromptPay + SlipOK) ---
# เบอร์มือถือหรือเลขบัตร/ภาษี ที่ผูก PromptPay รับเงิน
PROMPTPAY_ID=0812345678
PROMPTPAY_NAME=TokControl
# สมัครที่ https://slipok.com แล้วใส่ branchId + apiKey
SLIPOK_BRANCH_ID=your_slipok_branch_id
SLIPOK_API_KEY=your_slipok_api_key
# Optional: auto-approve donation slips without SlipOK (DEV ONLY — forced off when NODE_ENV=production)
# DONATE_DEV_AUTO_APPROVE=0
DONATE_DEV_AUTO_APPROVE=0
# โดเมนลิงก์สาธารณะแบบ subdomain (ใช้ได้เมื่อตั้ง DNS Wildcard แล้วเท่านั้น)
DONATE_PUBLIC_BASE_DOMAIN=control.app
# เปิด vanity subdomain เช่น name.control.app (ต้องมี DNS *.control.app ชี้เซิร์ฟเวอร์ก่อน)
DONATE_ENABLE_VANITY=0
# โดเมนหลักสำหรับลิงก์ OBS Widget / หน้าโดเนท
# หมายเหตุ: www.tokcontrol.com ตอนนี้เป็น GitHub Pages (ไม่มี Express) → จะ 404
# ค่าเริ่มต้นในโค้ดจึงใช้ Cloud Run จนกว่าจะตั้ง proxy และเปิดแฟล็กด้านล่าง
# TOKCONTROL_PUBLIC_SITE_URL=https://www.tokcontrol.com
# เมื่อชี้ tokcontrol.com มาที่ Cloud Run / มี reverse proxy แล้วค่อยเปิด:
# TOKCONTROL_PUBLIC_SITE_HAS_API=1
TOKCONTROL_PUBLIC_SITE_URL=https://pandy-backend-302414976454.asia-southeast1.run.app
APP_PUBLIC_URL=https://pandy-backend-302414976454.asia-southeast1.run.app
# แพ็กเกจราคาเป็น USD (PromptPay แปลงเป็นบาทด้วยอัตราแลกเปลี่ยนจริง)
# Game Center Early Access beta (ถึง 30 ก.ย. 2026 เวลาไทย)
GC_ACCESS_MODE=beta_addon
GC_PURCHASE_ENABLED=1
GC_EARLY_ACCESS_PRICE_THB=299
GC_EARLY_ACCESS_DAYS=30
# Default days when creating per-game unlock codes (admin can override per code)
GC_GAME_UNLOCK_DAYS=7
GC_BETA_ENDS_AT=2026-09-30T16:59:59.999Z
# แพ็ก PRO ทดลองตอนสมัครใหม่ — ปิดแล้ว (ต้องตั้ง =1 ถ้าจะเปิดรอบใหม่)
SIGNUP_PRO_TRIAL_ENABLED=0
# SIGNUP_PRO_TRIAL_START=2026-08-13T00:00:00.000Z
# SIGNUP_PRO_TRIAL_END=2026-09-30T16:59:59.999Z
# SIGNUP_PRO_TRIAL_DAYS=3

PAYMENT_PRICE_CURRENCY=USD
# สำรองถ้าดึงเรทออนไลน์ไม่ได้ (ปกติระบบดึงเรทตลาดอัตโนมัติ)
PAYMENT_USD_THB_RATE=36.5
# แคชเรทตลาดกี่นาที (ค่าเริ่มต้น 30)
PAYMENT_FX_CACHE_MINUTES=30
# แพ็กเกจราคา (JSON) — รวม PRO + เกมแยก + GAME PACK 3 (ทับ DEFAULT ใน payments.js ตาม id)
PAYMENT_PLANS=[{"id":"pro30","label":"PRO 30 วัน","days":30,"price":9.99,"productType":"pro"},{"id":"pro90","label":"PRO 90 วัน","days":90,"price":19.99,"productType":"pro"},{"id":"game_fish_30","label":"Fish Control (30 วัน)","days":30,"price":399,"currency":"THB","productType":"game","gameId":"fish-control"},{"id":"game_box_30","label":"Box Control (30 วัน)","days":30,"price":399,"currency":"THB","productType":"game","gameId":"minecraft"},{"id":"game_farm_30","label":"Farm Control (30 วัน)","days":30,"price":399,"currency":"THB","productType":"game","gameId":"farm-control"},{"id":"game_pack3_30","label":"GAME PACK 3 (30 วัน)","days":30,"price":999,"currency":"THB","productType":"game","gameIds":["farm-control","fish-control","minecraft"],"pack":true}]
# แจ้งแอดมินเมื่อมีคนซื้อ / ยืนยันมือ / ใช้โค้ด (Discord Incoming Webhook)
# ADMIN_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy
# เก็บไฟล์ media ข้ามเครื่อง (Google Cloud Storage) — ตั้งบน Cloud Run
# GCS_ASSETS_BUCKET=pandy-app-502306-user-assets
# GCS_ASSETS_PREFIX=assets
# โหมดทดสอบ: อนุมัติสลิปโดยไม่เรียก SlipOK (บังคับปิดเมื่อ NODE_ENV=production)
# PAYMENT_DEV_AUTO_APPROVE=0
PAYMENT_DEV_AUTO_APPROVE=0

