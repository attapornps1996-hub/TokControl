{
  "name": "pandy-app",
  "version": "2.1.19",
  "displayVersion": "2.1.19",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/attapornps1996-hub/TokControl.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "publish": "electron-builder --publish always",
    "package-win": "electron-packager . TokControl --platform=win32 --arch=x64 --icon=icon.ico --overwrite"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google-cloud/firestore": "^7.7.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.3",
    "express": "^4.19.2",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.2",
    "@google-cloud/storage": "^7.21.0",
    "crypto-js": "^4.2.0",
    "form-data": "^4.0.6",
    "msedge-tts": "^2.0.7",
    "nodemailer": "^6.10.1",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^5.1.7",
    "tiktok-live-connector": "^2.4.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.attapornps1996-hub.tokcontrol",
    "productName": "TokControl",
    "publish": [
      {
        "provider": "github",
        "owner": "attapornps1996-hub",
        "repo": "TokControl"
      }
    ],
    "win": {
      "target": "nsis",
      "executableName": "TokControl",
      "icon": "icon.png"
    },
    "nsis": {
      "shortcutName": "TokControl",
      "artifactName": "TokControl-Setup-${version}.${ext}"
    },
    "files": [
      "**/*",
      "!pandy-app-win32-x64/**",
      "!TokControl-win32-x64/**",
      "!dist/**",
      "!out/**",
      "!release/**",
      "!.git/**",
      "!.cursor/**",
      "!.freebuff/**",
      "!scratch/**",
      "!deploy/**",
      "!uploads/**",
      "!.env",
      "!.env.*",
      "!**/.env",
      "!**/*.zip",
      "!**/*.log",
      "!**/*.db",
      "!**/*.db-shm",
      "!**/*.db-wal",
      "!**/*.sqlite",
      "!database.db",
      "!chat_gift_debug.log",
      "!renderer_errors.txt",
      "!debug_events.log",
      "!data/local-*.txt",
      "!data/mc-bridge-token.txt",
      "!data/mc-rcon-password.txt",
      "!data/team_members_cache.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
