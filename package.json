{
  "name": "pandy-app",
  "version": "1.0.0",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/attapornps1996-hub/TokControl.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "publish": "electron-builder --publish always",
    "package-win": "electron-packager . pandy-app --platform=win32 --arch=x64 --icon=icon.ico --overwrite"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google-cloud/firestore": "^7.7.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.3",
    "express": "^4.19.2",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^5.1.7",
    "tiktok-live-connector": "^2.4.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.yourname.tiktokoverlay",
    "productName": "TikTok Live Overlay",
    "publish": [
      {
        "provider": "github",
        "owner": "attapornps1996-hub",
        "repo": "TokControl"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
